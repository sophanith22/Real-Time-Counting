# Copy this file to .env and fill in your own values.
# .env is git-ignored, so your camera credentials stay out of source control.

# Video source: RTSP stream URL, local file path, or 0 for webcam
VIDEO_SOURCE=rtsp://user:password@192.168.1.100:554/ch1/main/av_stream

# Set to 1 to enable verbose decision-logic logging (same as old DEBUG_MODE = True)
DEBUG_MODE=0